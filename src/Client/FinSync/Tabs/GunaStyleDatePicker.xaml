<UserControl x:Class="login.Helpers.GunaStyleDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="250" Height="50">
    <Grid>
        <!-- The main "card" button showing selected date -->
        <Border x:Name="CardBorder"
                Background="#121414"
                BorderBrush="#435152"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Button x:Name="DateButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White"
                    FontSize="14"
                    Padding="10"
                    HorizontalContentAlignment="Left"
                    Click="DateButton_Click">
                Select Date
            </Button>
        </Border>

        <!-- Popup with the calendar -->
        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=CardBorder}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#121414"
                    BorderBrush="#435152"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="5"
                    Margin="0,5,0,0">
                <Calendar x:Name="PopupCalendar"
                          Background="#121414"
                          Foreground="White"
                          BorderThickness="0"
                          SelectedDatesChanged="PopupCalendar_SelectedDatesChanged" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
